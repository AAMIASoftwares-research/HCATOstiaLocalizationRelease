    "import matplotlib.pyplot as plt\n",
    "\n",
    "def visualize_sample(data_dict):\n",
    "    \"\"\"\n",
    "    Visualizza la slice con la massima probabilità della heatmap \n",
    "    sovrapposta all'immagine originale.\n",
    "    \"\"\"\n",
    "    image = data_dict['image'][0, 0].cpu().numpy()  # Prende (Z, Y, X)\n",
    "    label = data_dict['label'][0, 0].cpu().numpy()  # Prende (Z, Y, X)\n",
    "    patient_id = data_dict.get('id', 'Unknown')\n",
    "\n",
    "    # 1. Trova la slice Z che contiene il picco della heatmap\n",
    "    z_idx = np.unravel_index(label.argmax(), label.shape)[0]\n",
    "    \n",
    "    print(f\"[*] Visualizzazione Paziente: {patient_id}\")\n",
    "    print(f\"[*] Slice selezionata (Z): {z_idx} (Valore max heatmap: {label.max():.4f})\")\n",
    "\n",
    "    # 2. Setup della figura\n",
    "    plt.figure(figsize=(12, 6))\n",
    "\n",
    "    # --- SOTTOPLOT 1: Immagine Originale ---\n",
    "    plt.subplot(1, 2, 1)\n",
    "    # Usiamo un range HU tipico per il cuore (Level 300, Width 800)\n",
    "    # ovvero vmin = 300 - 400 = -100, vmax = 300 + 400 = 700\n",
    "    plt.imshow(image[z_idx], cmap='gray', vmin=-100, vmax=700)\n",
    "    plt.title(f\"CT Slice {z_idx}\")\n",
    "    plt.axis('off')\n",
    "\n",
    "    # --- SOTTOPLOT 2: Overlay Heatmap ---\n",
    "    plt.subplot(1, 2, 2)\n",
    "    plt.imshow(image[z_idx], cmap='gray', vmin=-100, vmax=700)\n",
    "    \n",
    "    # Creiamo una maschera per la heatmap (solo dove il valore è significativo)\n",
    "    heatmap_slice = label[z_idx]\n",
    "    heatmap_masked = np.ma.masked_where(heatmap_slice < 0.05, heatmap_slice)\n",
    "    \n",
    "    plt.imshow(heatmap_masked, cmap='jet', alpha=0.6) # Overlay colorato\n",
    "    plt.colorbar(label='Probabilità Ostio')\n",
    "    plt.title(f\"Overlay Heatmap - {patient_id}\")\n",
    "    plt.axis('off')\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# --- ESECUZIONE TEST ---\n",
    "if __name__ == \"__main__\":\n",
    "    # Carichiamo un paziente (usa l'oggetto ds che abbiamo creato prima)\n",
    "    # data = ds.get() \n",
    "    \n",
    "    if data['label'].max() > 0:\n",
    "        visualize_sample(data)\n",
    "    else:\n",
    "        print(\"[!] Impossibile visualizzare: la label è vuota (tutti zeri).\")"
   ]
