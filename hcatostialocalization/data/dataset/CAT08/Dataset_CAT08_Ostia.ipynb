    "import os\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "# Add project root to path (works for both .py and .ipynb)\n",
    "try:\n",
    "    project_root = Path(__file__).parent.parent.parent.parent.parent\n",
    "except NameError:\n",
    "    # Running in Jupyter notebook - use fixed path\n",
    "    project_root = Path(r\"/path/to/data")\n",
    "    \n",
    "if str(project_root) not in sys.path:\n",
    "    sys.path.insert(0, str(project_root))\n",
    "\n",
    "import json\n",
    "import torch\n",
    "import yaml\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "from hcatostialocalization.config.config import config\n",
    "from hcatostialocalization.data.dataset.Base_Classes_ProvaMarco import LabeledDataset\n",
    "from hcatostialocalization.data.dataset.Heatmap_Config import HeatmapParams\n",
    "\n",
    "class Dataset_CAT08_Ostia(LabeledDataset):\n",
    "    \"\"\"\n",
    "    Dataset class per CAT08. \n",
    "    Gestisce volumi MHD/RAW e genera heatmap gaussiane basate su coordinate JSON.\n",
    "    \"\"\"\n",
    "\n",
    "    # Etichette coerenti con HeatmapParams\n",
    "    labels: dict[int, str] = {\n",
    "        0: \"background\",\n",
    "        1: \"RCA_ostium\",\n",
    "        2: \"LCA_ostium\",\n",
    "    }\n",
    "\n",
    "    def _init_data_pool(self) -> list[tuple[str, str]]:\n",
    "        # Peschiamo i percorsi dal config specifico per CAT08\n",
    "        yaml_path = config.dataset.CAT08.yaml_path \n",
    "        img_folder = config.dataset.CAT08.image_path\n",
    "        json_folder = config.dataset.CAT08.json_path\n",
    "        \n",
    "        if not os.path.exists(yaml_path):\n",
    "            raise FileNotFoundError(f\"[!] Config YAML non trovato in: {yaml_path}\")\n",
    "\n",
    "        with open(yaml_path, 'r') as f:\n",
    "            # Carichiamo lo split (train/val/test) definito per CAT08\n",
    "            split_dict = yaml.safe_load(f)['CAT08']['split']\n",
    "        \n",
    "        patient_ids = split_dict[self.split]\n",
    "        \n",
    "        # Scansione della cartella JSON per il matching\n",
    "        all_json_files = os.listdir(json_folder) if os.path.exists(json_folder) else []\n",
    "        \n",
    "        data_pool = []\n",
    "        for pid in patient_ids:\n",
    "            # In CAT08, i file sono nominati imageXX.mhd/imageXX.raw (non datasetXX)\n",
    "            # Cerca prima nella sottocartella pid/, poi nella cartella principale\n",
    "            im_f = os.path.join(img_folder, pid, f\"image{pid.replace('dataset', '')}.mhd\")\n",
    "            if not os.path.exists(im_f):\n",
    "                # Fallback: cerca direttamente nella cartella img_folder\n",
    "                im_f = os.path.join(img_folder, f\"image{pid.replace('dataset', '')}.mhd\")\n",
    "            \n",
    "            # Ricerca del file JSON corrispondente (datasetXX_labels.json)\n",
    "            lb_f = None\n",
    "            for filename in all_json_files:\n",
    "                if filename.lower().endswith('.json') and pid in filename:\n",
    "                    lb_f = os.path.join(json_folder, filename)\n",
    "                    break\n",
    "            \n",
    "            if im_f and os.path.exists(im_f) and lb_f:\n",
    "                data_pool.append((im_f, lb_f))\n",
    "            else:\n",
    "                print(f\"[!] Avviso: File non trovato per {pid} - Immagine: {os.path.exists(im_f) if im_f else False}, JSON: {lb_f}\")\n",
    "                \n",
    "        return data_pool\n",
    "\n",
    "    def _get_patient_id(self, current_patient: tuple[str, str]) -> str:\n",
    "        # Estrae l'ID (es. dataset00) dal percorso del file MHD\n",
    "        pid = os.path.basename(current_patient[0]).split('.')[0]\n",
    "        return f\"{self.split}-CAT08-{pid}\"\n",
    "\n",
    "    def _load_data(self, image_label_f: tuple[str, str], new_spacing: float|tuple|None = None) -> dict:\n",
    "        img_f, json_f = image_label_f\n",
    "        \n",
    "        # 1. Caricamento Volume (es: 512x512)\n",
    "        dict_img = self._load_volume_resize(img_f, which='image', new_spacing=new_spacing)\n",
    "        img_tensor = dict_img['tensor'] # (1, 1, Z, Y, X)\n",
    "        \n",
    "        # --- CORREZIONE LUMINOSITÀ E UNIFORMITÀ ---\n",
    "        img_tensor = img_tensor - 1024\n",
    "        \n",
    "        # Invertiamo SOLO l'immagine per portarla da LPS a RAS (allineandola al JSON)\n",
    "        # Flip sugli assi X (-1) e Y (-2)\n",
    "        img_tensor = torch.flip(img_tensor, dims=[-1, -2]) \n",
    "        \n",
    "        # 2. Setup Label\n",
    "        label_tensor = torch.zeros_like(img_tensor, dtype=torch.float)\n",
    "        D, H, W = img_tensor.shape[2:] # Z, Y, X\n",
    "\n",
    "        if os.path.exists(json_f):\n",
    "            with open(json_f, 'r') as f:\n",
    "                json_data = json.load(f)\n",
    "            \n",
    "            ostia_block = json_data.get(\"ostia\", {})\n",
    "            sigma = HeatmapParams.sigma\n",
    "            \n",
    "            for side in [\"R\", \"L\"]: \n",
    "                side_data = ostia_block.get(side)\n",
    "                if side_data and \"coordinate_ijk\" in side_data:\n",
    "                    coords = side_data[\"coordinate_ijk\"] # [X, Y, Z] nel JSON\n",
    "                    orig_x, orig_y, orig_z = float(coords[0]), float(coords[1]), float(coords[2])\n",
    "                    \n",
    "                    # --- SCALING DIMENSIONALE ---\n",
    "                    # Poiché l'immagine è 512 e il JSON è su base 1024, scaliamo del 50%\n",
    "                    # NON invertiamo (W-1 - x) perché l'immagine è già stata flippata sopra.\n",
    "                    scale_x = W / 1024.0 if orig_x > 512 else 1.0\n",
    "                    scale_y = H / 1024.0 if orig_y > 512 else 1.0\n",
    "                    \n",
    "                    new_x = orig_x * scale_x\n",
    "                    new_y = orig_y * scale_y\n",
    "                    new_z = orig_z # Z rimane invariata\n",
    "\n",
    "                    # 3. Disegno Heatmap\n",
    "                    if 0 <= new_z < D and 0 <= new_y < H and 0 <= new_x < W:\n",
    "                        self._draw_3d_gaussian(label_tensor[0, 0], center=(new_z, new_y, new_x), sigma=sigma)\n",
    "                    else:\n",
    "                        print(f\"[!] Warning: Punto {side} fuori range: ({new_z:.1f}, {new_y:.1f}, {new_x:.1f})\")\n",
    "\n",
    "        if self.split == 'train':\n",
    "            img_tensor = img_tensor.to(torch.float16)\n",
    "            label_tensor = label_tensor.to(torch.float16)\n",
    "            \n",
    "        return {\n",
    "            'image': img_tensor, \n",
    "            'label': label_tensor, \n",
    "            'spacing': dict_img['spacing'], \n",
    "            'spacing_orig': dict_img['spacing_orig'],\n",
    "            'id': self._get_patient_id(image_label_f)\n",
    "        }\n",
    "    def _draw_3d_gaussian(self, heatmap_tensor: torch.Tensor, center: tuple[float, float, float], sigma: float):\n",
    "        \"\"\"Generazione gaussiana 3D ottimizzata.\"\"\"\n",
    "        z_c, y_c, x_c = center\n",
    "        D, H, W = heatmap_tensor.shape\n",
    "        \n",
    "        radius = int(3 * sigma)\n",
    "        \n",
    "        # Bounding box\n",
    "        z0, z1 = max(0, int(z_c - radius)), min(D, int(z_c + radius) + 1)\n",
    "        y0, y1 = max(0, int(y_c - radius)), min(H, int(y_c + radius) + 1)\n",
    "        x0, x1 = max(0, int(x_c - radius)), min(W, int(x_c + radius) + 1)\n",
    "        \n",
    "        if z0 >= z1 or y0 >= y1 or x0 >= x1:\n",
    "            return\n",
    "\n",
    "        z_grid = torch.arange(z0, z1, dtype=torch.float, device=heatmap_tensor.device)\n",
    "        y_grid = torch.arange(y0, y1, dtype=torch.float, device=heatmap_tensor.device)\n",
    "        x_grid = torch.arange(x0, x1, dtype=torch.float, device=heatmap_tensor.device)\n",
    "        \n",
    "        grid_z, grid_y, grid_x = torch.meshgrid(z_grid, y_grid, x_grid, indexing='ij')\n",
    "        \n",
    "        dist_sq = (grid_z - z_c)**2 + (grid_y - y_c)**2 + (grid_x - x_c)**2\n",
    "        gaussian = torch.exp(-dist_sq / (2 * sigma**2))\n",
    "        \n",
    "        # Aggiornamento con valore massimo per evitare cancellazioni in caso di ostia vicini\n",
    "        heatmap_tensor[z0:z1, y0:y1, x0:x1] = torch.maximum(\n",
    "            heatmap_tensor[z0:z1, y0:y1, x0:x1], \n",
    "            gaussian\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    print(\"[*] Test di inizializzazione Dataset CAT08...\")\n",
    "    \n",
    "    # 1. Creiamo l'oggetto dataset\n",
    "    # Usiamo 'val' perché carica il volume intero senza fare ritagli (crop) casuali\n",
    "    ds = Dataset_CAT08_Ostia(split='val', nsdim=3)\n",
    "    \n",
    "    print(f\"[+] Dataset inizializzato. Pazienti trovati: {len(ds.data_pool)}\")\n",
    "    \n",
    "    # 2. Proviamo a caricare il primo paziente\n",
    "    print(\"[*] Caricamento del primo volume e generazione heatmap...\")\n",
    "    data = ds.get()\n",
    "    \n",
    "    print(f\"[+] Successo!\")\n",
    "    print(f\"    ID Paziente: {data['id']}\")\n",
    "    print(f\"    Shape Immagine: {data['image'].shape}\") # Dovrebbe essere (1, 1, Z, Y, X)\n",
    "    print(f\"    Shape Label: {data['label'].shape}\")\n",
    "    print(f\"    Valore max Label: {data['label'].max().item():.4f}\") \n",
    "    # Se il max è vicino a 1.0, la gaussiana è stata disegnata correttamente!"
   ]
  },
