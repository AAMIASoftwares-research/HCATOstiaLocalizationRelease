   "source": [
    "Code for the generation of a JSON file for each image of the ASOCA database."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "initial_id",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-02T12:53:34.590364600Z",
     "start_time": "2026-04-02T12:53:31.537199600Z"
    },
    "collapsed": true
   },
   "outputs": [],
   "source": [
    "import os\n",
    "import json\n",
    "\n",
    "def process_all_asoca_data(base_path):\n",
    "    categories = [\"Normal\", \"Diseased\"]\n",
    "\n",
    "    # 1. Ciclo attraverso entrambe le categorie principali (Normal e Diseased)\n",
    "    for category in categories:\n",
    "        print(f\"\\n=== Processando categoria: {category} ===\")\n",
    "\n",
    "        # Percorsi base per la categoria corrente\n",
    "        category_path = os.path.join(base_path, category)\n",
    "        ctca_path = os.path.join(category_path, \"CTCA\")\n",
    "        gml_path_base = os.path.join(category_path, \"Centerlines_graphs\")\n",
    "\n",
    "        # 2. Creazione della cartella di output SPECIFICA per la categoria\n",
    "        # Es: \"Normal_Annotations\" dentro la cartella \"Normal\"\n",
    "        output_dir = os.path.join(category_path, f\"{category}_Annotations\")\n",
    "        os.makedirs(output_dir, exist_ok=True)\n",
    "        print(f\"[*] Cartella di output pronta: {output_dir}\")\n",
    "\n",
    "        # Controllo di sicurezza se la cartella CTCA esiste\n",
    "        if not os.path.exists(ctca_path):\n",
    "            print(f\"[!] Attenzione: cartella {ctca_path} non trovata. Salto alla prossima categoria.\")\n",
    "            continue\n",
    "\n",
    "        # Prendo tutti i file .nrrd nella cartella CTCA\n",
    "        nrrd_files = [f for f in os.listdir(ctca_path) if f.endswith('.nrrd')]\n",
    "\n",
    "        # 3. Ciclo per ogni singola immagine trovata\n",
    "        for nrrd_file in nrrd_files:\n",
    "            base_name = nrrd_file.replace('.nrrd', '')\n",
    "            gml_file_path = os.path.join(gml_path_base, f\"{base_name}.GML\")\n",
    "\n",
    "            if not os.path.exists(gml_file_path):\n",
    "                print(f\"[!] File GML non trovato per {nrrd_file}, salto.\")\n",
    "                continue\n",
    "\n",
    "            # 4. Parsing del file GML a blocchi\n",
    "            ostia_data = {\"LEFT\": None, \"RIGHT\": None}\n",
    "\n",
    "            with open(gml_file_path, 'r', encoding='utf-8') as file:\n",
    "                lines = file.readlines()\n",
    "\n",
    "            in_node_block = False\n",
    "            current_node = {}\n",
    "\n",
    "            for line in lines:\n",
    "                line = line.strip()\n",
    "\n",
    "                # Capisco se sto entrando in un blocco \"node\"\n",
    "                if line == \"node [\":\n",
    "                    in_node_block = True\n",
    "                    # Resetto le variabili per il nuovo nodo\n",
    "                    current_node = {\"x\": None, \"y\": None, \"z\": None, \"is_ostium\": False, \"side\": None}\n",
    "\n",
    "                # Se sono dentro un nodo, cerco i dati che mi servono\n",
    "                elif in_node_block:\n",
    "                    if line == \"]\":\n",
    "                        # Fine del blocco nodo: se è un ostio, salvo le coordinate!\n",
    "                        in_node_block = False\n",
    "                        if current_node[\"is_ostium\"] and current_node[\"side\"]:\n",
    "                            side = current_node[\"side\"]\n",
    "                            ostia_data[side] = [current_node[\"x\"], current_node[\"y\"], current_node[\"z\"]]\n",
    "\n",
    "                    # Estraggo le coordinate e le info riga per riga\n",
    "                    elif line.startswith(\"x \"):\n",
    "                        current_node[\"x\"] = float(line.split()[1])\n",
    "                    elif line.startswith(\"y \"):\n",
    "                        current_node[\"y\"] = float(line.split()[1])\n",
    "                    elif line.startswith(\"z \"):\n",
    "                        current_node[\"z\"] = float(line.split()[1])\n",
    "                    elif line.startswith('topology \"OSTIUM\"'):\n",
    "                        current_node[\"is_ostium\"] = True\n",
    "                    elif line.startswith('side \"LEFT\"'):\n",
    "                        current_node[\"side\"] = \"LEFT\"\n",
    "                    elif line.startswith('side \"RIGHT\"'):\n",
    "                        current_node[\"side\"] = \"RIGHT\"\n",
    "\n",
    "            # 5. Creazione e salvataggio del file JSON nella cartella corretta\n",
    "            json_content = {\n",
    "                \"image_file\": nrrd_file,\n",
    "                \"category\": category,\n",
    "                \"ostia_coordinates\": ostia_data\n",
    "            }\n",
    "\n",
    "            json_filename = os.path.join(output_dir, f\"{base_name}.json\")\n",
    "            with open(json_filename, 'w') as json_file:\n",
    "                json.dump(json_content, json_file, indent=4)\n",
    "\n",
    "            # Print di log per vedere l'avanzamento\n",
    "            left_status = 'OK' if ostia_data['LEFT'] else 'MANCANTE'\n",
    "            right_status = 'OK' if ostia_data['RIGHT'] else 'MANCANTE'\n",
    "            print(f\"    -> Salvato: {base_name}.json [LEFT: {left_status} | RIGHT: {right_status}]\")\n",
    "\n",
    "# --- ESECUZIONE ---\n",
    "if __name__ == \"__main__\":\n",
    "    percorso_dataset = r\"/path/to/data"\n",
    "\n",
    "    try:\n",
    "        process_all_asoca_data(percorso_dataset)\n",
    "        print(\"\\n[+] Estrazione completata con successo per tutte le immagini e salvata nelle cartelle corrispondenti!\")\n",
    "    except Exception as e:\n",
    "        print(f\"\\n[!] Errore durante l'esecuzione: {e}\")"
   ]
  }
 ],
