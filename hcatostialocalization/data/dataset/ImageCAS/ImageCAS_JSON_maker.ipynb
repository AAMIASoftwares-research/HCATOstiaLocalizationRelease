   "source": [
    "import os\n",
    "import json\n",
    "import numpy as np\n",
    "import SimpleITK as sitk\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ==========================================\n",
    "# CONFIGURAZIONE DEI PATH\n",
    "# ==========================================\n",
    "IMAGES_DIR = r\"/path/to/data"\n",
    "ANNOTATIONS_DIR = r\"/path/to/data"\n",
    "# ==========================================\n",
    "\n",
    "def plot_ostium_slice(patient_id=\"2\", side=\"R\"):\n",
    "    \"\"\"\n",
    "    Carica l'immagine 3D e il JSON del paziente, estrae la slice 2D \n",
    "    corrispondente all'asse Z (K) e ci disegna sopra l'ostio.\n",
    "    \"\"\"\n",
    "    # 1. Costruisci i percorsi\n",
    "    json_path = os.path.join(ANNOTATIONS_DIR, f\"{patient_id}_final_ostia.json\")\n",
    "    img_path_gz = os.path.join(IMAGES_DIR, f\"{patient_id}.img.nii.gz\")\n",
    "    img_path_nii = os.path.join(IMAGES_DIR, f\"{patient_id}.img.nii\")\n",
    "    \n",
    "    img_path = img_path_gz if os.path.exists(img_path_gz) else img_path_nii\n",
    "    \n",
    "    # Controlli di sicurezza\n",
    "    if not os.path.exists(json_path):\n",
    "        print(f\"❌ JSON non trovato: {json_path}\")\n",
    "        return\n",
    "    if not os.path.exists(img_path):\n",
    "        print(f\"❌ Immagine non trovata: {img_path}\")\n",
    "        return\n",
    "\n",
    "    # 2. Leggi le coordinate dal JSON\n",
    "    with open(json_path, 'r', encoding='utf-8') as f:\n",
    "        data = json.load(f)\n",
    "        \n",
    "    if side not in data.get(\"ostia\", {}):\n",
    "        print(f\"⚠️ Ostio {side} non presente nel JSON del paziente {patient_id}\")\n",
    "        return\n",
    "\n",
    "    # Prendi le coordinate IJK\n",
    "    ijk = data[\"ostia\"][side][\"coordinate_ijk\"]\n",
    "    i, j, k = int(ijk[0]), int(ijk[1]), int(ijk[2])\n",
    "    print(f\"📍 Ostio {side} trovato alle coordinate IJK: ({i}, {j}, {k})\")\n",
    "\n",
    "    # 3. Carica l'immagine 3D e converti in Array Numpy\n",
    "    img = sitk.ReadImage(img_path)\n",
    "    # ATTENZIONE: SimpleITK converte l'ordine in (Z, Y, X) ovvero (K, J, I)\n",
    "    img_array = sitk.GetArrayFromImage(img) \n",
    "\n",
    "    # 4. Estrai la singola fetta 2D (slice) usando l'asse K\n",
    "    # Protezione nel caso K sia fuori dai limiti\n",
    "    k = min(max(k, 0), img_array.shape[0] - 1)\n",
    "    slice_2d = img_array[k, :, :]\n",
    "\n",
    "    # Windowing: Limitiamo i valori HU (Hounsfield Units) per migliorare il contrasto. \n",
    "    # Per i vasi con contrasto di solito [-200, 800] HU è un buon range.\n",
    "    slice_2d = np.clip(slice_2d, -200, 800)\n",
    "\n",
    "    # 5. Plot dell'immagine con Matplotlib\n",
    "    plt.figure(figsize=(8, 8))\n",
    "    \n",
    "    # Plotta la slice in bianco e nero\n",
    "    # origin='lower' o 'upper' dipende dall'orientamento nativo, di solito imshow va bene di default\n",
    "    plt.imshow(slice_2d, cmap='gray')\n",
    "    \n",
    "    # Aggiungi una croce rossa e un cerchio per l'ostio. \n",
    "    # x=i, y=j perché imshow lavora su (Y, X) e la nostra slice è (J, I)\n",
    "    plt.scatter(i, j, color='red', marker='+', s=300, linewidths=3, label=f'Ostio {side} (I={i}, J={j})')\n",
    "    plt.scatter(i, j, color='none', edgecolor='yellow', marker='o', s=400, linewidths=2)\n",
    "    \n",
    "    plt.title(f\"Paziente {patient_id} - Visualizzazione Ostio {side}\\nSlice Assiale K={k}\", fontsize=14)\n",
    "    plt.legend(loc='upper right')\n",
    "    plt.axis('off') # Nascondi gli assi\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# ESECUZIONE (Puoi cambiare il patient_id o il side 'R' / 'L')\n",
    "if __name__ == \"__main__\":\n",
    "    # Prova col paziente 1 (assicurati che il JSON si chiami 1_final_ostia.json)\n",
    "    plot_ostium_slice(patient_id=\"2\", side=\"R\")"
   ]
  }
