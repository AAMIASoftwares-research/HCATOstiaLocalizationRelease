   "source": [
    "import os\n",
    "import json\n",
    "import glob\n",
    "import numpy as np\n",
    "import SimpleITK as sitk\n",
    "from sklearn.cluster import KMeans\n",
    "from collections import defaultdict\n",
    "import concurrent.futures\n",
    "\n",
    "# ==========================================\n",
    "# CONFIGURAZIONE DEI PATH\n",
    "# ==========================================\n",
    "INPUT_DIR = r\"/path/to/data"\n",
    "OUTPUT_DIR = r\"/path/to/data"\n",
    "IMAGES_DIR = r\"/path/to/data"\n",
    "# ==========================================\n",
    "\n",
    "def lps_to_ras(coords):\n",
    "    \"\"\"Converte coordinate da LPS a RAS invertendo i segni degli assi X e Y.\"\"\"\n",
    "    return [-coords[0], -coords[1], coords[2]]\n",
    "\n",
    "def get_ijk_from_ras(img, ras_coords):\n",
    "    \"\"\"Converte coordinate RAS in indici IJK dell'immagine.\"\"\"\n",
    "    lps_coords = [-ras_coords[0], -ras_coords[1], ras_coords[2]]\n",
    "    ijk_coords = img.TransformPhysicalPointToIndex(lps_coords)\n",
    "    return list(ijk_coords)\n",
    "\n",
    "def process_single_patient(patient_id, annotation_files, images_dir, output_dir):\n",
    "    \"\"\"Funzione 'worker' eseguita in parallelo per ogni paziente.\"\"\"\n",
    "    try:\n",
    "        # 1. Cerca l'immagine\n",
    "        img_path_gz = os.path.join(images_dir, f\"{patient_id}.img.nii.gz\")\n",
    "        img_path_nii = os.path.join(images_dir, f\"{patient_id}.img.nii\")\n",
    "        \n",
    "        if os.path.exists(img_path_gz):\n",
    "            img_path = img_path_gz\n",
    "        elif os.path.exists(img_path_nii):\n",
    "            img_path = img_path_nii\n",
    "        else:\n",
    "            return f\"   ❌ Errore: Immagine non trovata per {patient_id}. Salto...\"\n",
    "                \n",
    "        # 2. Legge SOLO l'header per massima velocità\n",
    "        reader = sitk.ImageFileReader()\n",
    "        reader.SetFileName(img_path)\n",
    "        reader.ReadImageInformation()\n",
    "        \n",
    "        img = sitk.Image(reader.GetSize(), sitk.sitkUInt8)\n",
    "        img.SetOrigin(reader.GetOrigin())\n",
    "        img.SetSpacing(reader.GetSpacing())\n",
    "        img.SetDirection(reader.GetDirection())\n",
    "        \n",
    "        # 3. Raccoglie i punti degli annotatori\n",
    "        points_collector = {\"R\": [], \"L\": []}\n",
    "        for ann_file in annotation_files:\n",
    "            with open(ann_file, 'r', encoding='utf-8') as f:\n",
    "                data = json.load(f)\n",
    "                control_points = data.get('markups', [{}])[0].get('controlPoints', [])\n",
    "                \n",
    "                for pt in control_points:\n",
    "                    label = pt.get('label', '').upper()\n",
    "                    coords_lps = pt.get('position')\n",
    "                    \n",
    "                    if 'R' in label:\n",
    "                        points_collector[\"R\"].append(coords_lps)\n",
    "                    elif 'L' in label:\n",
    "                        points_collector[\"L\"].append(coords_lps)\n",
    "\n",
    "        # 4. Calcola i centroidi ed estrae le coordinate\n",
    "        final_ostia = {}\n",
    "        for side in [\"R\", \"L\"]:\n",
    "            pts = np.array(points_collector[side])\n",
    "            \n",
    "            if len(pts) == 0:\n",
    "                return f\"   ⚠️ Nessun punto trovato per il lato {side} nel paziente {patient_id}.\"\n",
    "                \n",
    "            kmeans = KMeans(n_clusters=1, n_init=10).fit(pts)\n",
    "            centroid_lps = kmeans.cluster_centers_[0]\n",
    "            \n",
    "            coords_ras = lps_to_ras(centroid_lps)\n",
    "            coords_ijk = get_ijk_from_ras(img, coords_ras)\n",
    "            \n",
    "            final_ostia[side] = {\n",
    "                \"coordinate_ras\": [round(float(c), 4) for c in coords_ras],\n",
    "                \"coordinate_ijk\": [int(c) for c in coords_ijk],\n",
    "                \"world_mm_original_lps\": [round(float(c), 4) for c in centroid_lps],\n",
    "                \"source_file\": f\"consensus_3_annotators.json\"\n",
    "            }\n",
    "\n",
    "        # 5. Salva il JSON finale\n",
    "        output_json = {\n",
    "            \"id_immagine\": patient_id,\n",
    "            \"spacing\": list(img.GetSpacing()),\n",
    "            \"orientation\": list(img.GetDirection()),\n",
    "            \"origin\": list(img.GetOrigin()),\n",
    "            \"ostia\": final_ostia,\n",
    "            \"comment\": \"Generato automaticamente tramite K-means consensus tra annotatori\",\n",
    "            \"other\": {}\n",
    "        }\n",
    "\n",
    "        output_file_path = os.path.join(output_dir, f\"{patient_id}_final_ostia.json\")\n",
    "        with open(output_file_path, 'w', encoding='utf-8') as out_f:\n",
    "            json.dump(output_json, out_f, indent=4)\n",
    "            \n",
    "        return f\"   ✅ Salvato con successo: {patient_id}\"\n",
    "        \n",
    "    except Exception as e:\n",
    "        return f\"   ❌ Errore imprevisto elaborando {patient_id}: {str(e)}\"\n",
    "\n",
    "def process_ostia_annotations():\n",
    "    os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "    print(f\"📁 Cartella di output: {OUTPUT_DIR}\\n\")\n",
    "    \n",
    "    # --- LOGICA DI RIPRESA (RESUME) ---\n",
    "    # Trova tutti i file già processati nella cartella di output\n",
    "    existing_files = glob.glob(os.path.join(OUTPUT_DIR, \"*_final_ostia.json\"))\n",
    "    completed_patients = set()\n",
    "    for f in existing_files:\n",
    "        filename = os.path.basename(f)\n",
    "        # Estrae l'ID dal nome del file (es: da \"1_final_ostia.json\" prende \"1\")\n",
    "        pid = filename.split('_')[0]\n",
    "        completed_patients.add(pid)\n",
    "    \n",
    "    if completed_patients:\n",
    "        print(f\"⏭️ Trovati {len(completed_patients)} pazienti già processati. Verranno saltati.\\n\")\n",
    "    \n",
    "    print(\"🔄 Analisi dei file di annotazione in corso...\\n\")\n",
    "\n",
    "    search_pattern = os.path.join(INPUT_DIR, \"*.mrk.json\")\n",
    "    files = glob.glob(search_pattern)\n",
    "    \n",
    "    # Raggruppa i file\n",
    "    groups = defaultdict(list)\n",
    "    for f in files:\n",
    "        filename = os.path.basename(f)\n",
    "        raw_patient_id = filename.split('_')[0] \n",
    "        try:\n",
    "            patient_id = str(int(raw_patient_id))\n",
    "        except ValueError:\n",
    "            continue\n",
    "        groups[patient_id].append(f)\n",
    "\n",
    "    # Prepara i task solo per i pazienti DA FARE\n",
    "    tasks = []\n",
    "    for patient_id, annotation_files in groups.items():\n",
    "        # Controlla se è già stato fatto\n",
    "        if patient_id in completed_patients:\n",
    "            continue # Salta silenziosamente per non intasare la console\n",
    "            \n",
    "        if len(annotation_files) < 3:\n",
    "            print(f\"⚠️ Salto il paziente {patient_id}: trovati solo {len(annotation_files)} annotatori.\")\n",
    "            continue\n",
    "            \n",
    "        tasks.append((patient_id, annotation_files))\n",
    "\n",
    "    if not tasks:\n",
    "        print(\"🎉 Tutti i pazienti sono già stati processati con successo!\")\n",
    "        return\n",
    "\n",
    "    print(f\"🚀 Avvio elaborazione parallela per i restanti {len(tasks)} pazienti...\\n\")\n",
    "\n",
    "    # ESECUZIONE PARALLELA TRAMITE MULTITHREADING\n",
    "    with concurrent.futures.ThreadPoolExecutor() as executor:\n",
    "        futures = [executor.submit(process_single_patient, pid, files, IMAGES_DIR, OUTPUT_DIR) for pid, files in tasks]\n",
    "        \n",
    "        for future in concurrent.futures.as_completed(futures):\n",
    "            print(future.result())\n",
    "\n",
    "    print(\"\\n🏁 Elaborazione completata!\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    process_ostia_annotations()"
   ]
  },
